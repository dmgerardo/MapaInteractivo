rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
    // Fotos de "Mis Localidades" (carpeta vieja, ya no se sube nada nuevo aquí,
    // se conserva solo para que las fotos ya subidas sigan siendo legibles).
    match /localidades/{archivo} {
      allow read: if true;
      allow write: if false;
    }
    // Carpeta genérica para fotos de cualquier capa administrada manualmente
    // (Mis Localidades, Mis Vecinos, y las que se agreguen después) — mismo correo
    // autorizado que database.rules.json. Mantener sincronizado si se agrega un
    // nuevo administrador.
    match /capas-manuales/{archivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'dmgerardo@gmail.com'
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
